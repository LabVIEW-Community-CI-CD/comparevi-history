{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labview-community-ci-cd.github.io/comparevi-history/schemas/comparevi-history-pr-comment-publication-v1.schema.json",
  "title": "comparevi-history pull request comment publication receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAtUtc",
    "repository",
    "workflowRunId",
    "artifactName",
    "summary"
  ],
  "properties": {
    "schema": {
      "const": "comparevi-history/pr-comment-publication@v1"
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "workflowRunId": {
      "type": "string",
      "minLength": 1
    },
    "artifactName": {
      "type": "string",
      "minLength": 1
    },
    "artifactZipPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifactRoot": {
      "type": [
        "string",
        "null"
      ]
    },
    "prRunPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "commentBodyPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "pullRequestNumber": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "workflowRunUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "previewPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "branch",
        "root",
        "manifestPath",
        "manifestUrl",
        "previewPairCount",
        "publishedImageCount",
        "commentPreviewPairs"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "not-required"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "manifestPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifestUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "previewPairCount": {
          "type": "integer",
          "minimum": 0
        },
        "publishedSurfaceCount": {
          "type": "integer",
          "minimum": 0
        },
        "publishedImageCount": {
          "type": "integer",
          "minimum": 0
        },
        "commentPreviewCards": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetId",
              "targetPath",
              "comparison",
              "surfaces"
            ],
            "properties": {
              "targetId": { "type": "string", "minLength": 1 },
              "targetPath": { "type": "string", "minLength": 1 },
              "comparison": { "type": "object" },
              "surfaces": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "surfaceKind",
                    "surfaceLabel",
                    "reportHtmlRelativePath",
                    "baseImagePath",
                    "baseImageUrl",
                    "headImagePath",
                    "headImageUrl"
                  ],
                  "properties": {
                    "surfaceKind": { "type": "string", "minLength": 1 },
                    "surfaceLabel": { "type": "string", "minLength": 1 },
                    "reportHtmlRelativePath": { "type": ["string", "null"] },
                    "baseImagePath": { "type": "string", "minLength": 1 },
                    "baseImageUrl": { "type": "string", "minLength": 1 },
                    "headImagePath": { "type": "string", "minLength": 1 },
                    "headImageUrl": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "commentPreviewPairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetId",
              "targetPath",
              "mode",
              "label",
              "sectionKind",
              "comparison",
              "reportHtmlRelativePath",
              "baseImagePath",
              "baseImageUrl",
              "headImagePath",
              "headImageUrl"
            ],
            "properties": {
              "targetId": { "type": "string", "minLength": 1 },
              "targetPath": { "type": "string", "minLength": 1 },
              "mode": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "sectionKind": { "type": "string", "minLength": 1 },
              "comparison": { "type": "object" },
              "reportHtmlRelativePath": { "type": ["string", "null"] },
              "baseImagePath": { "type": "string", "minLength": 1 },
              "baseImageUrl": { "type": "string", "minLength": 1 },
              "headImagePath": { "type": "string", "minLength": 1 },
              "headImageUrl": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "commentAction",
        "commentId",
        "commentUrl"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "commentAction": {
          "type": "string",
          "enum": [
            "none",
            "created",
            "updated",
            "unchanged"
          ]
        },
        "commentId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "commentUrl": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
