      "type": "object",
      "required": [
        "scope",
        "kind",
        "chunkId",
        "relativePath",
        "pathType",
        "contentType"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "run",
            "chunk"
          ]
        },
        "kind": {
          "type": "string"
        },
        "chunkId": {
          "type": [
            "string",
            "null"
          ]
        },
        "relativePath": {
          "type": "string"
        },
        "pathType": {
          "type": "string",
          "enum": [
            "file",
            "directory"
          ]
        },
        "contentType": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
