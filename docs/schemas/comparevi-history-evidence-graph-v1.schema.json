      "properties": {
        "catalogComplete": {
          "type": "boolean"
        },
        "catalogCompletenessReason": {
          "type": "string"
        },
        "finalStatus": {
          "type": "string"
        },
        "finalReason": {
          "type": "string"
        },
        "replayStatus": {
          "type": "string"
        },
        "replayReason": {
          "type": "string"
        },
        "bundleStatus": {
          "type": "string"
        },
        "bundleReason": {
          "type": "string"
        },
        "previewImageCount": {
          "type": "integer",
          "minimum": 0
        },
        "previewGalleryCap": {
          "type": "integer",
          "minimum": 0
        },
        "previewGalleryCount": {
          "type": "integer",
          "minimum": 0
        },
        "previewGalleryOmittedCount": {
          "type": "integer",
          "minimum": 0
        },
        "stepSummaryPreviewCap": {
          "type": "integer",
          "minimum": 0
        },
        "stepSummaryPreviewCount": {
